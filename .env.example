# ==============================================================================
# Walli - Environment configuration example
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==============================================================================

# --- General ---
APP_NAME=Walli
ENVIRONMENT=local
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# --- CORS ---
# Comma separated list of allowed origins for the frontend
# En producción, usa el dominio real por HTTPS, p. ej. https://walli-lawall.duckdns.org
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
# Browser-facing URL of the backend API (must be reachable from the browser, not just the container)
# En producción esta variable se hornea en el build de Vite (ver .github/workflows/deploy.yml,
# variable de repo VITE_API_BASE_URL), no se lee en runtime — debe apuntar al dominio real,
# p. ej. https://walli-lawall.duckdns.org/api
VITE_API_BASE_URL=http://localhost:8000/api

# --- Producción (VPS + Caddy) ---
# Dominio público servido por Caddy (frontend/Caddyfile). Usado solo por docker-compose.prod.yml.
DOMAIN=walli-lawall.duckdns.org

# --- Database ---
POSTGRES_USER=walli
POSTGRES_PASSWORD=walli
POSTGRES_DB=walli
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://walli:walli@postgres:5432/walli

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Encryption (used to encrypt mailbox credentials at rest) ---
# Must be a urlsafe base64-encoded 32 byte key, e.g. generated with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- LLM provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1000

# --- Langfuse (optional AI observability) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Mail worker ---
MAIL_POLL_INTERVAL_SECONDS=60
MAX_EMAILS_PER_RUN=20
MAX_RETRY_ATTEMPTS=3

# --- Documents / knowledge base ---
DOCUMENTS_STORAGE_PATH=/app/storage/documents
# Shared character budget for documents + web sources injected into the LLM prompt.
# Larger values include more knowledge but cost more tokens per LLM call.
MAX_KNOWLEDGE_CONTEXT_CHARS=600000

# --- Web sources (website crawled for knowledge context) ---
# How often (in seconds) the worker re-crawls each active web source. Default: daily.
WEB_SOURCE_POLL_INTERVAL_SECONDS=86400

# --- Initial admin seed user ---
INITIAL_ADMIN_EMAIL=admin@lawall.local
INITIAL_ADMIN_PASSWORD=change-me-please
INITIAL_ADMIN_FULL_NAME=Walli Admin
